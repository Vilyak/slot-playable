{
  "name": "pixi-ecs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "assets:generate": "tsx scripts/generate-slot-assets.ts",
    "assets:pack": "tsx scripts/pack-assets.ts",
    "predev": "npm run assets:generate && npm run assets:pack",
    "dev": "vite",
    "prebuild": "npm run assets:generate && npm run assets:pack",
    "build": "tsc -b && vite build && tsx scripts/ensure-single-html.ts",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@esotericsoftware/spine-pixi-v8": "^4.2.119",
    "@reduxjs/toolkit": "^2.12.0",
    "bitecs": "^0.4.0",
    "gsap": "^3.15.0",
    "pixi.js": "^8.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "free-tex-packer-core": "^0.3.9",
    "glob": "^13.0.6",
    "oxlint": "^1.75.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
